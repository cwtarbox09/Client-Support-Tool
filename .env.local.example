# Microsoft Azure AD App Registration
# Create an app registration at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here

# Use "common" for multi-tenant (supports all Azure AD tenants)
# Use your specific tenant ID to restrict to a single tenant
AZURE_AD_TENANT_ID=common

# NextAuth.js
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Set to your Vercel deployment URL in production
# For local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
